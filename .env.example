# Copia este archivo como .env. Local puede usar false; AWS debe usar true.
AUTH_ENABLED=false
OAUTH2_ISSUER_URI=https://PLACEHOLDER_SUBDOMAIN.ciamlogin.com/PLACEHOLDER_TENANT_ID/v2.0
OAUTH2_AUDIENCE=PLACEHOLDER_API_CLIENT_ID
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pedidos360
SPRING_DATASOURCE_USERNAME=PLACEHOLDER_DB_USER
SPRING_DATASOURCE_PASSWORD=PLACEHOLDER_DB_PASSWORD
